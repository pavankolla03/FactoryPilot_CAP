# Environment example — copy to .env and fill in. Never commit real values.
#
# Every value here is optional: the defaults run the whole MVP locally with no
# SAP account, no BTP and no external service (SQLite + in-process cache +
# synthetic S/4 fixture + deterministic offline LLM).

# --- Identity ---------------------------------------------------------------
# dev   = trust X-User-Id / X-User-Roles headers (local only)
# xsuaa = validate IAS/XSUAA JWTs (Day 13 of the delivery plan)
AUTH_MODE=dev
DEV_DEFAULT_USER=bob
DEV_DEFAULT_ROLES=BusinessUser,InsightsQuery,InsightsReadOwnUsage

# --- LLM --------------------------------------------------------------------
# fake | openrouter | aicore
LLM_PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# AI Core (only when LLM_PROVIDER=aicore). All five come from the AI Core
# service key: AI_API_URL, the deployment you created, and url/clientid/
# clientsecret from its "uaa" block. TOKEN_URL may be the uaa url on its own —
# /oauth/token is appended when it is missing.
AICORE_BASE_URL=
AICORE_DEPLOYMENT_ID=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_TOKEN_URL=
# Only set this if the deployment lives outside the "default" resource group.
AICORE_RESOURCE_GROUP=default

# --- S/4 access -------------------------------------------------------------
# fake       = replay docs/api/hub/delivery/sample_response.synthetic.json
# hub_direct = call the Accelerator Hub sandbox (needs SAP_HUB_API_KEY)
# cpi        = call the thin generic iFlow (needs CPI_URL)
S4_ACCESS_MODE=fake
SAP_HUB_API_KEY=
CPI_URL=
CPI_TOKEN=

# --- Persistence ------------------------------------------------------------
# sqlite | postgres — CAP owns this schema either way
DB_ENGINE=sqlite
SQLITE_PATH=apps/admin-cap/db/factorypilot.db
POSTGRES_DSN=

# --- Cache and rate-limit counters -----------------------------------------
# memory | redis — memory is single-process only, use redis for >1 replica
CACHE_ENGINE=memory
REDIS_URL=redis://localhost:6379/0

# --- Behaviour --------------------------------------------------------------
DEFAULT_WAREHOUSE=1000
ENABLE_LLM_INTENT_FALLBACK=false
