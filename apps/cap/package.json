{
  "name": "factorypilot-cap",
  "version": "0.1.0",
  "private": true,
  "description": "FactoryPilot CAP services \u2014 config, tokenisation, admin, audit, insights",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cap-js/postgres": "^3.0.1",
    "@sap/cds": "^10.0.5",
    "@sap/xssec": "^4.13.3",
    "express": "^4.21.2",
    "redis": "^6.2.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds-dk": "^10.0.6"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy": "cds deploy --to sqlite:db/factorypilot.db",
    "deploy:pg": "cds deploy --to postgres --profile production",
    "build": "node scripts/validate-xs-app.js && node scripts/validate-seeds.js && cds build --production",
    "test": "FACTORYPILOT_DEMO_MODE=1 node --test --test-concurrency=1 test/*.test.js",
    "validate:router": "node scripts/validate-xs-app.js",
    "validate:seeds": "node scripts/validate-seeds.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/factorypilot.db"
        },
        "[production]": {
          "kind": "postgres"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": {
            "password": "admin",
            "roles": [
              "ConfigRead",
              "ConfigMaintain",
              "CacheMaintain",
              "TokenRead",
              "TokenMaintain",
              "AdminRead",
              "AdminMaintain",
              "AuditRead",
              "DashboardAdmin",
              "InsightsQuery",
              "InsightsReadOwnUsage",
              "CacheRead",
              "IntegrationRead",
              "IntegrationMaintain",
              "DashboardRead"
            ]
          },
          "viewer": {
            "password": "viewer",
            "roles": [
              "ConfigRead",
              "TokenRead",
              "AdminRead",
              "AuditRead",
              "CacheRead",
              "IntegrationRead",
              "DashboardRead"
            ]
          },
          "bob": {
            "password": "bob",
            "roles": [
              "InsightsQuery",
              "InsightsReadOwnUsage"
            ]
          },
          "newstarter": {
            "password": "newstarter",
            "roles": [
              "InsightsQuery",
              "InsightsReadOwnUsage"
            ]
          },
          "newadmin": {
            "password": "newadmin",
            "roles": [
              "InsightsQuery",
              "InsightsReadOwnUsage",
              "AdminMaintain",
              "AdminRead"
            ]
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    },
    "features": {
      "assert_integrity": false
    }
  }
}
