{
  "_version": "1.59.0",
  "sap.app": {
    "id": "factorypilot.integrationendpoints",
    "type": "application",
    "title": "Integration Endpoints",
    "description": "Connect any iFlow by pasting its endpoint. Test before activating.",
    "applicationVersion": {
      "version": "0.1.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/integration/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "integrationendpoints-manage": {
          "semanticObject": "IntegrationEndpoint",
          "action": "manage",
          "title": "Integration Endpoints",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "EndpointsList",
          "pattern": ":?query:",
          "target": "EndpointsList"
        },
        {
          "name": "EndpointsDetail",
          "pattern": "Endpoints({key}):?query:",
          "target": "EndpointsDetail"
        }
      ],
      "targets": {
        "EndpointsList": {
          "type": "Component",
          "id": "EndpointsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Endpoints",
              "variantManagement": "Page",
              "navigation": {
                "Endpoints": {
                  "detail": {
                    "route": "EndpointsDetail"
                  }
                }
              }
            }
          }
        },
        "EndpointsDetail": {
          "type": "Component",
          "id": "EndpointsDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Endpoints",
              "navigation": {}
            }
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
