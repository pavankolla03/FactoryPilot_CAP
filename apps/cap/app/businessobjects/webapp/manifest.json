{
  "_version": "1.59.0",
  "sap.app": {
    "id": "factorypilot.businessobjects",
    "type": "application",
    "title": "Business Objects",
    "description": "Register S/4HANA OData services. Each active row becomes an agent tool.",
    "applicationVersion": { "version": "0.1.0" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/config/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "businessobjects-manage": {
          "semanticObject": "BusinessObject",
          "action": "manage",
          "title": "Business Objects",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.fe.templates": {} }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "BusinessObjectsList",
          "pattern": ":?query:",
          "target": "BusinessObjectsList"
        },
        {
          "name": "BusinessObjectsDetail",
          "pattern": "BusinessObjects({key}):?query:",
          "target": "BusinessObjectsDetail"
        }
      ],
      "targets": {
        "BusinessObjectsList": {
          "type": "Component",
          "id": "BusinessObjectsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "BusinessObjects",
              "variantManagement": "Page",
              "navigation": {
                "BusinessObjects": { "detail": { "route": "BusinessObjectsDetail" } }
              }
            }
          }
        },
        "BusinessObjectsDetail": {
          "type": "Component",
          "id": "BusinessObjectsDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "BusinessObjects",
              "navigation": {}
            }
          }
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
