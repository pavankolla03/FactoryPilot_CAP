{
  "welcomeFile": "/insights/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "^/insights/(.*)$",
      "target": "/insights/$1",
      "destination": "factorypilot-orchestrator",
      "authenticationType": "xsuaa",
      "scope": ["$XSAPPNAME.InsightsQuery"],
      "csrfProtection": false
    },
    {
      "source": "^/odata/admin/(.*)$",
      "target": "/odata/admin/$1",
      "destination": "factorypilot-admin-cap",
      "authenticationType": "xsuaa",
      "scope": {
        "GET": ["$XSAPPNAME.ConfigRead", "$XSAPPNAME.ConfigMaintain", "$XSAPPNAME.DashboardRead", "$XSAPPNAME.DashboardAdmin"],
        "default": ["$XSAPPNAME.ConfigMaintain", "$XSAPPNAME.RateLimitMaintain", "$XSAPPNAME.CacheMaintain"]
      },
      "csrfProtection": true
    },
    {
      "source": "^/admin/(.*)$",
      "target": "/$1",
      "destination": "factorypilot-admin-cap",
      "authenticationType": "xsuaa",
      "scope": ["$XSAPPNAME.ConfigRead", "$XSAPPNAME.ConfigMaintain"]
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "cacheControl": "no-cache, no-store, must-revalidate"
    }
  ]
}
